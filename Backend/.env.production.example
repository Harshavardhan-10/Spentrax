# Production environment template — copy values into your host's environment
# (Render dashboard / Docker env) and never commit real secrets.

# PostgreSQL connection string (Render generates one via the blueprint)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/spentrax

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI provider: rule_based (no key needed) or openai (set a real API key)
AI_PROVIDER=rule_based
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# Public frontend URL
FRONTEND_URL=https://spentrax-web.onrender.com
CORS_ORIGINS=https://spentrax-web.onrender.com

MAX_CSV_SIZE_MB=5